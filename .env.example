APP_NAME="CvSU OSAS Scholarship Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Reuse the database connection across requests. Worth enabling against a remote
# database, where the handshake costs more than the queries. Safe with a
# session-mode pooler; leave off for a transaction-mode pooler (Supabase :6543).
# DB_PERSISTENT=false
#
# Both of the following make Postgres run an extra statement on every connection,
# which costs a full round trip against a remote database. They are unset by
# default because Postgres already defaults to UTF8 and to a search path that
# includes "public". Set them only if your database actually needs them.
# DB_CHARSET=utf8
# DB_SEARCH_PATH=public

# Offline mode only (docker-compose.offline.yml). Local throwaway credentials.
# POSTGRES_DB=osas
# POSTGRES_USER=osas
# POSTGRES_PASSWORD=osas

# Vercel deployment (Dockerfile.vercel + vercel.json). None of these belong in
# this file or in the image — set them on the project with `vercel env add`, or
# in Project Settings > Environment Variables:
#
#   APP_KEY               reuse the existing one; a new key invalidates every
#                         live session and signed URL
#   APP_URL               https://<project>.vercel.app, or the custom domain
#   DB_URL                the Supabase pooler on :6543 (transaction mode), not
#                         the :5432 session-mode port used locally — Vercel runs
#                         many instances and session mode holds one Postgres
#                         backend per connection
#   DB_PERSISTENT         false, for the same reason (see the note above)
#   SUPABASE_STORAGE_*    the four values from the block above, unchanged
#
# Dockerfile.vercel already sets APP_ENV, APP_DEBUG, LOG_CHANNEL, the session,
# cache, queue and filesystem drivers, and SESSION_SECURE_COOKIE. Leave those
# alone unless something needs to differ per environment.
#
# For `vercel dev` locally, put the same values in .env.local and add
# SESSION_SECURE_COOKIE=false — that host is plain http, and a Secure cookie
# would be dropped, which reads as "login silently does nothing".

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail delivery. MAIL_PASSWORD is a Google App Password (16 characters, no
# spaces) generated at https://myaccount.google.com/apppasswords, not the
# account's own password — Google rejects that over SMTP. Set MAIL_MAILER=log
# to keep mail out of the network and in storage/logs/laravel.log instead.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=osas.scholarships@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="osas.scholarships@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Supabase Storage (S3-compatible) — used for scholarship application document uploads.
# Get these from Supabase Dashboard > Project Settings > Storage > S3 Connection.
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_BUCKET=scholarship-documents
SUPABASE_STORAGE_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# Sign in with Google (students). The OAuth 2.0 "Web application" client ID
# from Google Cloud Console > APIs & Services > Credentials. No secret is needed.
GOOGLE_CLIENT_ID=
