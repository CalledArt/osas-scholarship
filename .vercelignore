# What the Vercel CLI uploads when it builds the container.
#
# Distinct from .dockerignore, and needed alongside it: .dockerignore decides
# what enters the image, this decides what leaves this machine at all. Without
# it .env — live Supabase database and storage credentials — is transmitted to
# the build machine on every deploy, even though the image would never copy it.
#
# Kept deliberately identical to .dockerignore. The build is known to work with
# exactly these paths absent, so mirroring it cannot break the image.
node_modules
vendor
public/build

# Secrets, and anything that quotes them.
.env
.env.*
auth.json
storage/*.key

# Development runtime. None of it is reachable from Vercel.
Dockerfile
docker-compose*.yml

# Not executed in production, and composer install runs with --no-dev.
tests
phpunit.xml
.phpunit.result.cache

# Regenerated by the image; excluded so no host state leaks in.
storage/framework/cache
storage/framework/sessions
storage/framework/views
storage/logs
*.sqlite

# Agent and editor scratch space, plus project documentation.
.agents
.ai
.claude
.cursor
.idea
.impeccable
.kiro
.vscode
.git
.github
.mcp.json
boost.json
skills-lock.json
*.md

# Windows shell artifact committed by accident: a psysh error dump.
delete('connectivity-check.txt'))
