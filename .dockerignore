# Shared by both images, which want opposite things from it:
#
#   Dockerfile         copies no application code at all (compose bind mounts it)
#   Dockerfile.vercel  copies the application and IS what gets deployed
#
# So this file is written for the second one. Anything listed here is absent
# from the production image, which makes it the last gate on what ships.

# Installed inside the image, in their own build stages. Never copied in from
# the host, where they may hold platform-specific or development-only builds.
node_modules
vendor
public/build

# Secrets, and anything that quotes them.
.env
.env.*
auth.json
storage/*.key

# Development runtime. None of it is reachable from Vercel.
Dockerfile
docker-compose*.yml

# Not executed in production, and composer install runs with --no-dev.
tests
phpunit.xml
.phpunit.result.cache

# Regenerated by the image; excluded so no host state leaks in.
storage/framework/cache
storage/framework/sessions
storage/framework/views
storage/logs
*.sqlite

# Agent and editor scratch space, plus project documentation.
.agents
.ai
.claude
.cursor
.idea
.impeccable
.kiro
.vscode
.git
.github
.mcp.json
boost.json
skills-lock.json
*.md

# Windows shell artifact committed by accident: a psysh error dump.
delete('connectivity-check.txt'))
